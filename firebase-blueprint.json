{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Store user health data and profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "bloodGroup": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["uid", "createdAt"]
    },
    "Reminder": {
      "title": "Medicine Reminder",
      "description": "Store medical reminders for users",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "medicineName": { "type": "string" },
        "dosage": { "type": "string" },
        "time": { "type": "string" },
        "days": { "type": "array" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "medicineName", "time", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/reminders/{reminderId}": {
      "schema": "Reminder",
      "description": "Global collection of medical reminders"
    }
  }
}
